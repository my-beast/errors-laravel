{
    "name": "mybeast/errors-laravel",
    "description": "Laravel SDK for MyBeast Errors (services.my-beast.com/errors): your app's errors, scrubbed, grouped, alerted.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0",
        "justinrainbow/json-schema": "^6.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": { "MyBeast\\Errors\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "MyBeast\\Errors\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["MyBeast\\Errors\\Laravel\\ErrorsServiceProvider"],
            "aliases": {}
        }
    },
    "scripts": {
        "test": "phpunit",
        "demo": ["@php vendor/bin/testbench workbench:build --ansi", "@php vendor/bin/testbench demo:traffic --ansi"]
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
