# The demo app's .env: copy to workbench/.env (git leaves it out) and fill the secret.
APP_NAME="Errors SDK demo"
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
DB_CONNECTION=sqlite
QUEUE_CONNECTION=sync

# A project in the local errors service (http://localhost:8004) and one of its server secrets.
MYBEAST_ERRORS_URL=http://localhost:8004
MYBEAST_ERRORS_SECRET=
MYBEAST_ERRORS_ENVIRONMENT=demo
MYBEAST_ERRORS_RELEASE=demo-1

# Performance on: a quarter of the ordinary requests and jobs, and every one slower than a second.
MYBEAST_ERRORS_PERFORMANCE=true
MYBEAST_ERRORS_PERFORMANCE_SAMPLE_RATE=0.25
MYBEAST_ERRORS_PERFORMANCE_SLOW_MS=1000
